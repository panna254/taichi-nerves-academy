# API Configuration
# Set this to your backend API URL
# Leave empty or set VITE_USE_MOCK_API=true to use mock API
VITE_API_BASE_URL=http://localhost:3000/api

# Use mock API (set to "true" to use mock data instead of real backend)
# This is automatically true if VITE_API_BASE_URL is not set
VITE_USE_MOCK_API=false

# Example for production:
# VITE_API_BASE_URL=https://api.taichinerves.com/api
